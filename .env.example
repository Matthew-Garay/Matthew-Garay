# Copia este archivo a .env y rellena los valores reales.
# Nunca subas el archivo .env con credenciales reales al repositorio.

# Configuración general del proyecto
APP_NAME=Portafolio de Matthew Garay
APP_ENV=local
APP_DEBUG=true

# Configuración de base de datos (si aplica)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tu_base_de_datos
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña

# Claves de API y servicios externos
API_KEY=tu_clave_de_api_aqui
SECRET_KEY=tu_secreto_aqui
